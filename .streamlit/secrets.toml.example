# Copy file ini menjadi .streamlit/secrets.toml untuk local development.
# Mode paling simpel: pakai public Google Sheet CSV, tanpa service account.
# Jangan commit .streamlit/secrets.toml kalau nanti berisi credential asli.

GOOGLE_SHEET_ID = "your_google_sheet_id"
GOOGLE_SHEET_GID = "0"

# Alternatif: isi direct CSV URL hasil Publish to web.
# Kalau ini diisi, app akan memakai URL ini dan mengabaikan GOOGLE_SHEET_ID/GID.
# GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/xxx/pub?gid=0&single=true&output=csv"

# Optional: Apps Script Web App URL untuk auto-write Session Generator ke tab sessions.
# Deploy Google Apps Script sebagai Web App, lalu paste URL /exec di sini.
# SESSION_WEBHOOK_URL = "https://script.google.com/macros/s/xxx/exec"
# SESSION_WEBHOOK_TOKEN = "optional-secret-token"

# Required untuk membuka halaman admin di Streamlit.
ADMIN_PASSWORD = "change-this-password"

# Optional kalau suatu hari mau pakai private Google Sheet via service account.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "sunmory-attendance@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/sunmory-attendance%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
